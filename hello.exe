# garde of student based on marks :  ,  

marks = int(input("Enter your maeks : "))
grade = None

if(marks >= 90):
    grade = "A"
elif(marks >=80 and marks <90):
    grade = "B"    
elif(marks >=70 and marks < 80):
    grade = 'C'
else:
    grade = "D"

print(grade)

    

