# indexing in String : str[something] 
# to access character in a string

str = 'hello world'

# ye errroe degga : to index ko assign nhi manupilated nhi kra skte : 

print(str[0])
print(str[1])
print(str[2])
print(str[3])
print(str[4])
print(str[5])
print(str[6])
print(str[7])
print(str[8])
print(str[9])
print(str[10])


#   Slicing : to return part of string : 
#      02345678910
str = "Hello world"

print(str[0:11]) # last character is excluded 
print(str[0:len(str)])

print(str[:len(str)])  # same as 0:len(str)
print(str[0:]) # same as 0:len(str)

# -ve indexing :

#      54321 (in -ve)
str = "Apple"

print(str[-5:-4])